# Razorpay TEST MODE keys only. Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Local state
EXCHANGE_DB_PATH=runs/exchange.db

# LLM provider: "ollama" (local) or "deepseek" (production)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:latest
DEEPSEEK_API_KEY=

# Optional per-tier models. Both fall back to LLM_MODEL when unset.
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
